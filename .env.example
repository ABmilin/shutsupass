POSTGRES_USER=shutsupass
POSTGRES_PASSWORD=shutsupass
POSTGRES_DB=shutsupass
JWT_SECRET=devsecret_change_me

# 翻訳エンジン。通常は libretranslate、Ollamaを使う場合は ollama。
TRANSLATION_PROVIDER=libretranslate

# Ollama使用時のモデル。初回起動時にollama-initコンテナが取得する。
OLLAMA_MODEL=gemma2:2b

# 同一Wi-Fi内の別端末からデモする場合は、MacのIPアドレスに変更する。
# 例: VITE_API_URL=http://192.168.1.23:4000
VITE_API_URL=http://localhost:4000
